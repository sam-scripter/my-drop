# ── Secrets ─────────────────────────────────────────────────────────────
# Never commit these
backend/.env
.env
firebase-service-account*.json

# ── Node.js ─────────────────────────────────────────────────────────────
node_modules/
*.log
npm-debug.log*

# ── React build output ───────────────────────────────────────────────────
web/dist/
web/build/

# ── Prisma ───────────────────────────────────────────────────────────────
# Generated client is rebuilt during Docker build
backend/node_modules/.prisma

# ── OS clutter ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── Flutter ───────────────────────────────────────────────────────────────
# Build outputs
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Android generated files
app/android/.gradle/
app/android/local.properties
app/android/key.properties

# iOS generated files
app/ios/Pods/
app/ios/.symlinks/

# Firebase config — contains project credentials
# These are auto-generated by flutterfire and safe to commit
# but if you regenerate them for prod, keep them out of dev repo
# app/lib/firebase_options.dart  ← keep this committed

# macOS
app/macos/Flutter/GeneratedPluginRegistrant.swift