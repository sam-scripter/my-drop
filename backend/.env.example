# .env.example — copy to .env and fill in real values
# This file is safe to commit — contains no secrets

# Database
POSTGRES_DB=mydrop
POSTGRES_USER=mydrop_user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://mydrop_user:rzaxdeufzphhyz4@db:5432/mydrop

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# App
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://mydrop.duckdns.org

# Base URL for tracking links sent to customers
TRACKING_BASE_URL=https://mydrop.duckdns.org/track

# Firebase — fill in after Phase 1.4
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Twilio — WhatsApp/SMS, fill in Phase 6
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Google Maps — fill in Phase 4
GOOGLE_MAPS_API_KEY=